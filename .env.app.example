# Copy this file to .env.app.production (or .env.app.development) and fill in real values.
# Never commit the actual .env.app.* files — they are gitignored.

DATABASE_NAME=aftermarketmonkey-db
DATABASE_USER=aftermarketmonkey_admin
DATABASE_HOST=5.161.121.143          # DB runs directly on the host, not in Docker
DATABASE_PASSWORD=change_me
DATABASE_PORT=5432

CACHE_HOST=cache-redis
CACHE_PORT=6379

EMAIL_HOST_PASSWORD=

KEYSTONE_FTP_USER=
KEYSTONE_FTP_PASSWORD=

ASAP_NETWORK_API_TOKEN=
ASAP_NETWORK_MAX_CONCURRENT_REQUESTS=4
ASAP_NETWORK_MAX_REQUESTS_PER_SECOND=5

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=change_me        # also used as MEILI_MASTER_KEY for the meilisearch container
MEILI_MASTER_KEY=change_me              # must match MEILISEARCH_MASTER_KEY above
MEILISEARCH_INDEX_PARTS=parts

STRIPE_SECRET_KEY=

RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=no-reply@aftermarketscout.com
PURCHASE_ORDER_INTERNAL_CC_EMAIL=
FRONTEND_BASE_URL=

ANTHROPIC_API_KEY=
TAVILY_API_KEY=
REOON_API_KEY=

SECRET_KEY=change_me_to_a_long_random_string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,localhost

# Ship-to address autocomplete & validation (src/integrations/address/).
# GEOAPIFY_API_KEY is the only one that must be set -- without it the feature degrades to
# "no suggestions, every address unverified" and nothing else breaks. The rest are tuning
# knobs with working defaults in conf/settings_base.py; leave them blank unless you mean to
# override. ADDRESS_ALLOWED_COUNTRIES is a comma-separated ISO2 list (blank = no restriction).
GEOAPIFY_API_KEY=
ADDRESS_PROVIDER=
ADDRESS_PROVIDER_TIMEOUT_SECONDS=
ADDRESS_VALIDATE_TIMEOUT_SECONDS=
ADDRESS_SUGGEST_LIMIT=
ADDRESS_SUGGESTION_CACHE_TTL_SECONDS=
ADDRESS_VALIDATION_CONFIDENCE_THRESHOLD=
ADDRESS_VALIDATION_CORRECTION_FLOOR=
ADDRESS_SUGGEST_RATE_LIMIT_PER_MINUTE=
ADDRESS_ALLOWED_COUNTRIES=
ADDRESS_SUGGEST_DEFAULT_COUNTRY=

# Instantly -> FreshSales reply sync (manage.py sync_instantly_replies, 15-minute cron).
# INSTANTLY_API_KEY needs scopes emails:read + leads:read + campaigns:read (Instantly: Settings ->
# Integrations -> API Keys). FRESHSALES_API_KEY comes from Profile Settings -> API Settings and
# inherits its owner's permissions. FRESHSALES_BUNDLE_ALIAS is the <name> in
# https://<name>.myfreshworks.com. Without all three the command exits and nothing else breaks.
# The rest are tuning knobs with working defaults in conf/settings_base.py -- leave blank unless
# you mean to override.
INSTANTLY_API_KEY=
FRESHSALES_API_KEY=
FRESHSALES_BUNDLE_ALIAS=
INSTANTLY_BASE_URL=
INSTANTLY_TIMEOUT_SECONDS=
INSTANTLY_SYNC_OVERLAP_MINUTES=
INSTANTLY_SYNC_INITIAL_DAYS=
INSTANTLY_INTEREST_RECHECK_DAYS=
INSTANTLY_INTEREST_RECHECK_HOURS=
FRESHSALES_TIMEOUT_SECONDS=
FRESHSALES_DEFAULT_DEAL_AMOUNT=
FRESHSALES_MAX_CALLS_PER_RUN=
