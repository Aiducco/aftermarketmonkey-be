# Staging env for the be stack. On the staging VM: copy to ~/aftermarketmonkey-be/.env.app.staging (chmod 600).
# bootstrap-vm.sh writes it with freshly generated secrets; never reuse a production value, never commit the copy.
# Used both as the app's env_file and for docker compose interpolation (--env-file .env.app.staging).

STAGING_HOST=stage.aftermarketscout.com
FRONTEND_BASE_URL=https://stage.aftermarketscout.com

# Generated: openssl rand -hex 32. Must differ from production (conf.settings_staging refuses prod's JWT secret).
DJANGO_SECRET_KEY=<generate>
JWT_SECRET=<generate>

# The stack's own Postgres container (DATABASE_HOST is set to "postgres" by docker-compose.staging.yml).
DATABASE_NAME=aftermarketscout_staging
DATABASE_USER=staging
DATABASE_PASSWORD=<generate>

CACHE_PASSWORD=<generate>
MEILISEARCH_MASTER_KEY=<generate>

# Stripe: empty until a test-mode account exists (decision 2026-11-23); billing pages show their error state.
# Only sk_test_/whsec_ test values ever go here: conf.settings_staging refuses a live key.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email: Django mail goes to the container log. Leave Resend empty (or a key limited to an allowlisted test address).
RESEND_API_KEY=

# Deliberately absent: distributor credentials, CRM keys (FreshSales, Instantly, Apollo), scraping and AI keys.
# Staging makes no live distributor or CRM calls.
